# Copiar a .env y cambiar TODOS los valores antes de arrancar Docker.
# El .env real NUNCA se sube al repositorio (está en .gitignore).

# --- Base de datos (aplicación PHP) ---
DB_HOST=db
DB_NAME=nicosport
DB_USER=nicosport_user
DB_PASS=cambia_esta_clave_fuerte

# --- Root de MySQL (solo contenedor db) ---
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
